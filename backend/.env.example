# Local development defaults to SQLite. For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/aptinexus
DATABASE_URL=sqlite:///./aptinexus.db
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep true for local prototype; set false in production after running Alembic migrations.
AUTO_CREATE_TABLES=true
